{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/admin-login/?",
      "dest": "/admin_login.html"
    },
    {
      "src": "/admin/?",
      "dest": "/admin.html"
    },
    {
      "src": "/logo.jpg",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    }
  ]
}